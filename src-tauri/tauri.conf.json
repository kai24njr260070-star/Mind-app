{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Signature",
  "version": "0.1.0",
  "identifier": "app.mindsignature.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5174",
    "devUrl": "http://localhost:5174/app.html",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mind Signature",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#070b18",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
